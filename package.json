{
  "name": "attyd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo run --",
    "build:client": "vite build",
    "build": "npm run build:rust",
    "build:rust": "cargo build --release",
    "start": "./target/release/attyd",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "vitest run",
    "test:rust": "ATTYD_SKIP_WEB_BUILD=1 cargo test",
    "test:remote": "ATTYD_SKIP_WEB_BUILD=1 cargo build && node --import tsx scripts/rust-remote-smoke.ts",
    "test:browser": "npm run build:client && ATTYD_SKIP_WEB_BUILD=1 cargo build && playwright test",
    "test:goose": "ATTYD_SKIP_WEB_BUILD=1 cargo build && node --import tsx scripts/goose-smoke.ts",
    "test:binary": "node --import tsx scripts/binary-smoke.ts",
    "test:ui": "npm run build:client && ATTYD_SKIP_WEB_BUILD=1 cargo build && node --import tsx scripts/ui-smoke.ts",
    "test:coverage": "node --import tsx scripts/rust-coverage.ts",
    "licenses": "node --import tsx scripts/third-party-licenses.ts",
    "test:browser:serve": "node --import tsx scripts/browser-server.ts",
    "check": "npm run typecheck && npm test && npm run build:client"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "happy-dom": "^20.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
