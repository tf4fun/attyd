{
  "name": "attyd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo run --",
    "dev:node": "tsx watch server/cli.ts --dev",
    "build:client": "vite build",
    "build:node": "vite build && tsc -p tsconfig.server.json",
    "build": "npm run build:rust",
    "build:rust": "npm run build:client && ATTYD_SKIP_WEB_BUILD=1 cargo build --release",
    "start": "./target/release/attyd",
    "start:node": "node dist/server/server/cli.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "vitest run",
    "test:rust": "ATTYD_SKIP_WEB_BUILD=1 cargo test",
    "test:rust:remote": "ATTYD_SKIP_WEB_BUILD=1 cargo build && node --import tsx scripts/rust-remote-smoke.ts",
    "test:browser": "npm run build:client && playwright test",
    "test:goose": "node --import tsx scripts/goose-smoke.ts",
    "test:binary": "node --import tsx scripts/binary-smoke.ts",
    "test:ui": "npm run test:ui:rust",
    "test:ui:node": "npm run build:client && node --import tsx scripts/ui-smoke.ts",
    "test:ui:rust": "npm run build:client && ATTYD_SKIP_WEB_BUILD=1 cargo build && ATTYD_SMOKE_BACKEND=rust node --import tsx scripts/ui-smoke.ts",
    "test:coverage:backends": "node --import tsx scripts/backend-coverage.ts",
    "test:ui:serve": "node --import tsx scripts/fake-ui-server.ts",
    "check": "npm run typecheck && npm test && npm run test:rust && npm run test:rust:remote && npm run test:ui:rust && npm run build && npm run test:binary"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.2.0-beta.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
